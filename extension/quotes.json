[
  {
    "text": "甘其食，美其服，安其居，乐其俗。",
    "book": "道德经",
    "chapter": "第八十章",
    "speaker": "老子",
    "id": "dq-5274ece3"
  },
  {
    "text": "居善地，心善渊，与善仁，言善信，正善治，事善能，动善时。",
    "book": "道德经",
    "chapter": "第八章",
    "speaker": "老子",
    "id": "dq-290bfbc1"
  },
  {
    "text": "水善利万物而不争，处众人之所恶，故几于道。",
    "book": "道德经",
    "chapter": "第八章",
    "speaker": "老子",
    "id": "dq-d68f6a36"
  },
  {
    "text": "为天下式，常德不忒，复归于无极。",
    "book": "道德经",
    "chapter": "第二十八章",
    "speaker": "老子",
    "id": "dq-38f90cd6"
  },
  {
    "text": "为天下溪，常德不离，复归于婴儿。",
    "book": "道德经",
    "chapter": "第二十八章",
    "speaker": "老子",
    "id": "dq-5deeb2e6"
  },
  {
    "text": "重为轻根，静为躁君。",
    "book": "道德经",
    "chapter": "第二十六章",
    "speaker": "老子",
    "id": "dq-4c27b279"
  },
  {
    "text": "不贵其师，不爱其资，虽智大迷，是谓要妙。",
    "book": "道德经",
    "chapter": "第二十七章",
    "speaker": "老子",
    "id": "dq-156f3e7a"
  },
  {
    "text": "上善若水。",
    "book": "道德经",
    "chapter": "第八章",
    "speaker": "老子",
    "id": "dq-c40ccc80"
  },
  {
    "text": "常善救物，故无弃物，是谓袭明。",
    "book": "道德经",
    "chapter": "第二十七章",
    "speaker": "老子",
    "id": "dq-cac31215"
  },
  {
    "text": "故善人者，不善人之师。",
    "book": "道德经",
    "chapter": "第二十七章",
    "speaker": "老子",
    "id": "dq-62e27bf3"
  },
  {
    "text": "善闭无关楗而不可开，善结无绳约而不可解。",
    "book": "道德经",
    "chapter": "第二十七章",
    "speaker": "老子",
    "id": "dq-56baaf23"
  },
  {
    "text": "善行无辙迹，善言无瑕讁。",
    "book": "道德经",
    "chapter": "第二十七章",
    "speaker": "老子",
    "id": "dq-3adb8037"
  },
  {
    "text": "是以圣人常善救人，故无弃人。",
    "book": "道德经",
    "chapter": "第二十七章",
    "speaker": "老子",
    "id": "dq-ccd038d1"
  },
  {
    "text": "同于道者，道亦乐得之。",
    "book": "道德经",
    "chapter": "第二十三章",
    "speaker": "老子",
    "id": "dq-148a3b74"
  },
  {
    "text": "希言自然。",
    "book": "道德经",
    "chapter": "第二十三章",
    "speaker": "老子",
    "id": "dq-28d2f468"
  },
  {
    "text": "故道大，天大，地大，王亦大。",
    "book": "道德经",
    "chapter": "第二十五章",
    "speaker": "老子",
    "id": "dq-753d0071"
  },
  {
    "text": "人法地，地法天，天法道，道法自然。",
    "book": "道德经",
    "chapter": "第二十五章",
    "speaker": "老子",
    "id": "dq-ccaa8927"
  },
  {
    "text": "道之为物，惟恍惟惚。",
    "book": "道德经",
    "chapter": "第二十一章",
    "speaker": "老子",
    "id": "dq-f29769af"
  },
  {
    "text": "孔德之容，惟道是从。",
    "book": "道德经",
    "chapter": "第二十一章",
    "speaker": "老子",
    "id": "dq-5f6d2d9b"
  },
  {
    "text": "其精甚真，其中有信。",
    "book": "道德经",
    "chapter": "第二十一章",
    "speaker": "老子",
    "id": "dq-c2b08db1"
  },
  {
    "text": "故有无相生，难易相成，长短相较，高下相倾，音声相和，前后相随。",
    "book": "道德经",
    "chapter": "第二章",
    "speaker": "老子",
    "id": "dq-6cad7cf2"
  },
  {
    "text": "皆知善之为善，斯不善已。",
    "book": "道德经",
    "chapter": "第二章",
    "speaker": "老子",
    "id": "dq-5756d0bb"
  },
  {
    "text": "我有三宝，持而保之。一曰慈，二曰俭，三曰不敢为天下先。",
    "book": "道德经",
    "chapter": "第六十七章",
    "speaker": "老子",
    "id": "dq-9db7553a"
  },
  {
    "text": "合抱之木，生于毫末。九层之台，起于累土。千里之行，始于足下。",
    "book": "道德经",
    "chapter": "第六十四章",
    "speaker": "老子",
    "id": "dq-2023e226"
  },
  {
    "text": "江海所以能为百谷王者，以其善下之，故能为百谷王。",
    "book": "道德经",
    "chapter": "第六十六章",
    "speaker": "老子",
    "id": "dq-8ac95a05"
  },
  {
    "text": "是以天下乐推而不厌，以其不争，故天下莫能与之争。",
    "book": "道德经",
    "chapter": "第六十六章",
    "speaker": "老子",
    "id": "dq-fd887660"
  },
  {
    "text": "夫轻诺必寡信，多易必多难。",
    "book": "道德经",
    "chapter": "第六十三章",
    "speaker": "老子",
    "id": "dq-7c6c3fb8"
  },
  {
    "text": "其安易持，其未兆易谋。",
    "book": "道德经",
    "chapter": "第六十四章",
    "speaker": "老子",
    "id": "dq-67d71d92"
  },
  {
    "text": "治大国，若烹小鲜。",
    "book": "道德经",
    "chapter": "第六十章",
    "speaker": "老子",
    "id": "dq-8b79bc46"
  },
  {
    "text": "玄德深矣，远矣，与物反矣，然后乃至大顺。",
    "book": "道德经",
    "chapter": "第六十五章",
    "speaker": "老子",
    "id": "dq-8f852ac1"
  },
  {
    "text": "天之道，其犹张弓与。",
    "book": "道德经",
    "chapter": "第七十七章",
    "speaker": "老子",
    "id": "dq-8eb6c6b2"
  },
  {
    "text": "天之道，损有余而补不足。",
    "book": "道德经",
    "chapter": "第七十七章",
    "speaker": "老子",
    "id": "dq-c21d2284"
  },
  {
    "text": "天之道，不争而善胜，不言而善应，不召而自来，繟然而善谋。",
    "book": "道德经",
    "chapter": "第七十三章",
    "speaker": "老子",
    "id": "dq-5db79c6f"
  },
  {
    "text": "故失道而后德，失德而后仁，失仁而后义，失义而后礼。",
    "book": "道德经",
    "chapter": "第三十八章",
    "speaker": "老子",
    "id": "dq-bfef3f6d"
  },
  {
    "text": "上德不德，是以有德。",
    "book": "道德经",
    "chapter": "第三十八章",
    "speaker": "老子",
    "id": "dq-5d5eae04"
  },
  {
    "text": "上德无为而无以为，下德为之而有以为。",
    "book": "道德经",
    "chapter": "第三十八章",
    "speaker": "老子",
    "id": "dq-1ea65bb6"
  },
  {
    "text": "功成事遂，百姓皆谓：我自然。",
    "book": "道德经",
    "chapter": "第十七章",
    "speaker": "老子",
    "id": "dq-14c28b76"
  },
  {
    "text": "上仁为之而无以为，上义为之而有以为。",
    "book": "道德经",
    "chapter": "第三十八章",
    "speaker": "老子",
    "id": "dq-116454b0"
  },
  {
    "text": "孰能浊以静之徐清。",
    "book": "道德经",
    "chapter": "第十五章",
    "speaker": "老子",
    "id": "dq-fce8615b"
  },
  {
    "text": "道常无名，朴虽小，天下莫能臣也。",
    "book": "道德经",
    "chapter": "第三十二章",
    "speaker": "老子",
    "id": "dq-01d8be6d"
  },
  {
    "text": "譬道之在天下，犹川谷之于江海。",
    "book": "道德经",
    "chapter": "第三十二章",
    "speaker": "老子",
    "id": "dq-b38c7973"
  },
  {
    "text": "不欲以静，天下将自定。",
    "book": "道德经",
    "chapter": "第三十七章",
    "speaker": "老子",
    "id": "dq-b7eb1e80"
  },
  {
    "text": "知人者智，自知者明。",
    "book": "道德经",
    "chapter": "第三十三章",
    "speaker": "老子",
    "id": "dq-28650ce5"
  },
  {
    "text": "大道泛兮，其可左右。",
    "book": "道德经",
    "chapter": "第三十四章",
    "speaker": "老子",
    "id": "dq-bb620434"
  },
  {
    "text": "道之出口，淡乎其无味，视之不足见，听之不足闻，用之不足既。",
    "book": "道德经",
    "chapter": "第三十五章",
    "speaker": "老子",
    "id": "dq-8a1c8d67"
  },
  {
    "text": "知常容，容乃公，公乃全，全乃天，天乃道，道乃久，没身不殆。",
    "book": "道德经",
    "chapter": "第十六章",
    "speaker": "老子",
    "id": "dq-7fdcee4f"
  },
  {
    "text": "能知古始，是谓道纪。",
    "book": "道德经",
    "chapter": "第十四章",
    "speaker": "老子",
    "id": "dq-1c649bd1"
  },
  {
    "text": "执古之道，以御今之有。",
    "book": "道德经",
    "chapter": "第十四章",
    "speaker": "老子",
    "id": "dq-aa05220e"
  },
  {
    "text": "保此道者不欲盈，夫唯不盈，故能蔽不新成。",
    "book": "道德经",
    "chapter": "第十五章",
    "speaker": "老子",
    "id": "dq-8cb8e4a6"
  },
  {
    "text": "古之善为士者，微妙玄通，深不可识。",
    "book": "道德经",
    "chapter": "第十五章",
    "speaker": "老子",
    "id": "dq-c33f5026"
  },
  {
    "text": "明白四达，能无为乎。",
    "book": "道德经",
    "chapter": "第十章",
    "speaker": "老子",
    "id": "dq-05eecec0"
  },
  {
    "text": "生而不有，为而不恃，长而不宰，是谓玄德。",
    "book": "道德经",
    "chapter": "第十章",
    "speaker": "老子",
    "id": "dq-fa2afb87"
  },
  {
    "text": "为学日益，为道日损。",
    "book": "道德经",
    "chapter": "第四十八章",
    "speaker": "老子",
    "id": "dq-937a9409"
  },
  {
    "text": "道生一，一生二，二生三，三生万物。",
    "book": "道德经",
    "chapter": "第四十二章",
    "speaker": "老子",
    "id": "dq-7735eb78"
  },
  {
    "text": "万物负阴而抱阳，冲气以为和。",
    "book": "道德经",
    "chapter": "第四十二章",
    "speaker": "老子",
    "id": "dq-88e7e00d"
  },
  {
    "text": "不善者，吾亦善之，德善。",
    "book": "道德经",
    "chapter": "第四十九章",
    "speaker": "老子",
    "id": "dq-f092f60f"
  },
  {
    "text": "不信者，吾亦信之，德信。",
    "book": "道德经",
    "chapter": "第四十九章",
    "speaker": "老子",
    "id": "dq-2f603878"
  },
  {
    "text": "上士闻道，勤而行之。",
    "book": "道德经",
    "chapter": "第四十一章",
    "speaker": "老子",
    "id": "dq-02fa7249"
  },
  {
    "text": "反者道之动，弱者道之用。",
    "book": "道德经",
    "chapter": "第四十章",
    "speaker": "老子",
    "id": "dq-13bc00f7"
  },
  {
    "text": "挫其锐，解其纷，和其光，同其尘，湛兮似或存。",
    "book": "道德经",
    "chapter": "第四章",
    "speaker": "老子",
    "id": "dq-abbda69a"
  },
  {
    "text": "道冲而用之或不盈，渊兮似万物之宗。",
    "book": "道德经",
    "chapter": "第四章",
    "speaker": "老子",
    "id": "dq-aa4c2c08"
  },
  {
    "text": "见小曰明，守柔曰强。",
    "book": "道德经",
    "chapter": "第五十二章",
    "speaker": "老子",
    "id": "dq-c336f60d"
  },
  {
    "text": "是谓深根固柢，长生久视之道。",
    "book": "道德经",
    "chapter": "第五十九章",
    "speaker": "老子",
    "id": "dq-ba919156"
  },
  {
    "text": "重积德则无不克，无不克则莫知其极。",
    "book": "道德经",
    "chapter": "第五十九章",
    "speaker": "老子",
    "id": "dq-74cbef03"
  },
  {
    "text": "大道甚夷，而民好径。",
    "book": "道德经",
    "chapter": "第五十三章",
    "speaker": "老子",
    "id": "dq-7fb99448"
  },
  {
    "text": "胜人者有力，自胜者强。",
    "book": "道德经",
    "chapter": "第三十三章",
    "speaker": "老子",
    "id": "dq-d3bd781a"
  },
  {
    "text": "善建者不拔，善抱者不脱，子孙以祭祀不辍。",
    "book": "道德经",
    "chapter": "第五十四章",
    "speaker": "老子",
    "id": "dq-0230bdf0"
  },
  {
    "text": "修之于身，其德乃真。",
    "book": "道德经",
    "chapter": "第五十四章",
    "speaker": "老子",
    "id": "dq-92dd531c"
  },
  {
    "text": "含德之厚，比于赤子。",
    "book": "道德经",
    "chapter": "第五十五章",
    "speaker": "老子",
    "id": "dq-68298f16"
  },
  {
    "text": "道生之，德畜之，物形之，势成之。",
    "book": "道德经",
    "chapter": "第五十一章",
    "speaker": "老子",
    "id": "dq-011d42ea"
  },
  {
    "text": "道之尊，德之贵，夫莫之命而常自然。",
    "book": "道德经",
    "chapter": "第五十一章",
    "speaker": "老子",
    "id": "dq-ac1def52"
  },
  {
    "text": "是以万物莫不尊道而贵德。",
    "book": "道德经",
    "chapter": "第五十一章",
    "speaker": "老子",
    "id": "dq-556d4df8"
  },
  {
    "text": "道可道，非常道，名可名，非常名。",
    "book": "道德经",
    "chapter": "第一章",
    "speaker": "老子",
    "id": "dq-893fdd09"
  },
  {
    "text": "苟日新，日日新，又日新。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-371f5969"
  },
  {
    "text": "此谓诚于中，形于外，故君子必慎其独也。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-a782b39d"
  },
  {
    "text": "此谓国不以利为利，以义为利也。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-4cdaa3a5"
  },
  {
    "text": "大学之道，在明明德，在亲民，在止于至善。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-fd99bb31"
  },
  {
    "text": "道得众则得国，失众则失国。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-1bd9a988"
  },
  {
    "text": "道善则得之，不善则失之矣。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-eb98da6e"
  },
  {
    "text": "富润屋，德润身，心广体胖，故君子必诚其意。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-4cd7f921"
  },
  {
    "text": "古之欲明明德于天下者，先治其国。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-8c470144"
  },
  {
    "text": "君子贤其贤而亲其亲，小人乐其乐而利其利，此以没世不忘也。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-5026746b"
  },
  {
    "text": "是故君子有大道，必忠信以得之，骄泰以失之。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-f3d9edcf"
  },
  {
    "text": "物有本末，事有终始，知所先后，则近道矣。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-62ead8a0"
  },
  {
    "text": "心诚求之，虽不中不远矣。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-b75ed85e"
  },
  {
    "text": "尧舜率天下以仁，而民从之。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-ea02878f"
  },
  {
    "text": "有斐君子，终不可喧兮者，道盛德至善，民之不能忘也。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-9171481f"
  },
  {
    "text": "欲正其心者，先诚其意。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-6f6d4a21"
  },
  {
    "text": "知止而后有定，定而后能静，静而后能安，安而后能虑，虑而后能得。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-36b213ca"
  },
  {
    "text": "博厚配地，高明配天，悠久无疆。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-7bab6cdd"
  },
  {
    "text": "博学之，审问之，慎思之，明辨之，笃行之。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-88416147"
  },
  {
    "text": "不息则久，久则征，征则悠远，悠远则博厚，博厚则高明。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-e9832f7c"
  },
  {
    "text": "诚者，物之终始，不诚无物。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-658a5dc3"
  },
  {
    "text": "诚者不勉而中，不思而得，从容中道，圣人也。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-43334a03"
  },
  {
    "text": "诚者非自成己而已也，所以成物也。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-6bd8777f"
  },
  {
    "text": "诚之者，择善而固执之者也。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-9d670da8"
  },
  {
    "text": "道也者，不可须臾离也，可离非道也。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-4ec21067"
  },
  {
    "text": "道之不明也，我知之矣：贤者过之，不肖者不及也。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-cb57caca"
  },
  {
    "text": "道之不行也，我知之矣：知者过之，愚者不及也。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-67903958"
  },
  {
    "text": "凡事豫则立，不豫则废。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-c70e79df"
  },
  {
    "text": "非天子不议礼，不制度，不考文。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-7865a20b"
  },
  {
    "text": "君子素其位而行，不愿乎其外。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-a366f54b"
  },
  {
    "text": "夫孝者，善继人之志，善述人之事者也。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-265bf157"
  },
  {
    "text": "莫见乎隐，莫显乎微，故君子慎其独也。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-a81a4099"
  },
  {
    "text": "故大德必得其位，必得其禄，必得其名，必得其寿。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-49d0f32b"
  },
  {
    "text": "故君子不动而敬，不言而信。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-56fbb51a"
  },
  {
    "text": "故君子和而不流，强哉矫。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-9f0fabc3"
  },
  {
    "text": "故君子之道，暗然而日章。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-e0e7f18f"
  },
  {
    "text": "故君子尊德性而道问学，致广大而尽精微，极高明而道中庸。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-31a34456"
  },
  {
    "text": "故为政在人，取人以身，修身以道，修道以仁。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-393e8f0f"
  },
  {
    "text": "国有道，不变塞焉，强哉矫。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-ba5fd970"
  },
  {
    "text": "果能此道矣，虽愚必明，虽柔必强。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-d1960b10"
  },
  {
    "text": "回之为人也，择乎中庸，得一善，则拳拳服膺而弗失之矣。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-9d1b5bfc"
  },
  {
    "text": "或安而行之，或利而行之，或勉强而行之。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-ae58d543"
  },
  {
    "text": "或生而知之，或学而知之，或困而知之，及其知之，一也。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-ac88da31"
  },
  {
    "text": "见而民莫不敬，言而民莫不信，行而民莫不说。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-c3774d04"
  },
  {
    "text": "君子之道，造端乎夫妇，及其至也，察乎天地。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-d55e73d9"
  },
  {
    "text": "宽柔以教，不报无道，南方之强也，君子居之。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-02e1ab18"
  },
  {
    "text": "齐明盛服，非礼不动，所以修身也。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-fc20c913"
  },
  {
    "text": "曲能有诚，诚则形，形则著，著则明，明则动，动则变，变则化。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-dd28f4ff"
  },
  {
    "text": "去谗远色，贱货而贵德，所以劝贤也。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-ddcf5120"
  },
  {
    "text": "人之为道而远人，不可以为道。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-e2546ed9"
  },
  {
    "text": "诗云：予怀明德，不大声以色。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-41fca28d"
  },
  {
    "text": "是故君子动而世为天下道，行而世为天下法，言而世为天下则。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-27aa2107"
  },
  {
    "text": "舜好问而好察迩言，隐恶而扬善，执其两端，用其中于民，其斯以为舜乎。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-a1240809"
  },
  {
    "text": "虽有其德，苟无其位，亦不敢作礼乐焉。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-e2c0eaea"
  },
  {
    "text": "虽有其位，苟无其德，不敢作礼乐焉。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-8fd92bcc"
  },
  {
    "text": "所求乎朋友，先施之，未能也。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-120131e3"
  },
  {
    "text": "天地之道，可壹言而尽也。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-9e36ac90"
  },
  {
    "text": "天地之道：博也，厚也，高也，明也，悠也，久也。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-bd020ab9"
  },
  {
    "text": "天命之谓性，率性之谓道，修道之谓教。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-68b5303b"
  },
  {
    "text": "万物并育而不相害，道并行而不相悖。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-4166ba0d"
  },
  {
    "text": "唯天下至诚，为能尽其性。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-7ca86d22"
  },
  {
    "text": "唯天下至诚，为能经纶天下之大经，立天下之大本，知天地之化育。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-1f14363e"
  },
  {
    "text": "温故而知新，敦厚以崇礼。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-ba1dcb6e"
  },
  {
    "text": "小德川流，大德敦化，此天地之所以为大也。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-03dc4350"
  },
  {
    "text": "性之德也，合外内之道也。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-6333414b"
  },
  {
    "text": "言前定则不跲，事前定则不困，行前定则不疚，道前定则不穷。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-4e87c8b8"
  },
  {
    "text": "知、仁、勇三者，天下之达德也，所以行之者一也。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-3f5f664b"
  },
  {
    "text": "致中和，天地位焉，万物育焉。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-139e5ffc"
  },
  {
    "text": "君使臣以礼，臣事君以忠。",
    "book": "论语",
    "chapter": "八佾",
    "speaker": "孔子",
    "id": "dq-b2861a93"
  },
  {
    "text": "绘事后素。",
    "book": "论语",
    "chapter": "八佾",
    "speaker": "孔子",
    "id": "dq-01a0747b"
  },
  {
    "text": "听其言而观其行。",
    "book": "论语",
    "chapter": "公冶长",
    "speaker": "孔子",
    "id": "dq-5a1fda11"
  },
  {
    "text": "老者安之，朋友信之，少者怀之。",
    "book": "论语",
    "chapter": "公冶长",
    "speaker": "孔子",
    "id": "dq-02e6453c"
  },
  {
    "text": "晏平仲善与人交，久而敬之。",
    "book": "论语",
    "chapter": "公冶长",
    "speaker": "孔子",
    "id": "dq-c92131d9"
  },
  {
    "text": "见善如不及，见不善如探汤。",
    "book": "论语",
    "chapter": "季氏",
    "speaker": "孔子",
    "id": "dq-17c7e97d"
  },
  {
    "text": "益者三友，损者三友：友直，友谅，友多闻，益矣。",
    "book": "论语",
    "chapter": "季氏",
    "speaker": "孔子",
    "id": "dq-f3f5feae"
  },
  {
    "text": "富与贵，是人之所欲也，不以其道得之，不处也。",
    "book": "论语",
    "chapter": "里仁",
    "speaker": "孔子",
    "id": "dq-7e71b102"
  },
  {
    "text": "君子无终食之闲违仁，造次必于是，颠沛必于是。",
    "book": "论语",
    "chapter": "里仁",
    "speaker": "孔子",
    "id": "dq-9e3638cc"
  },
  {
    "text": "君子之于天下也，无适也，无莫也，义之与比。",
    "book": "论语",
    "chapter": "里仁",
    "speaker": "孔子",
    "id": "dq-70ad2ae5"
  },
  {
    "text": "不义而富且贵，于我如浮云。",
    "book": "论语",
    "chapter": "述而",
    "speaker": "孔子",
    "id": "dq-aabe086e"
  },
  {
    "text": "多闻，择其善者而从之，多见而识之，知之次也。",
    "book": "论语",
    "chapter": "述而",
    "speaker": "孔子",
    "id": "dq-a556ee3f"
  },
  {
    "text": "饭疏食，饮水，曲肱而枕之，乐亦在其中矣。",
    "book": "论语",
    "chapter": "述而",
    "speaker": "孔子",
    "id": "dq-2851d421"
  },
  {
    "text": "加我数年，五十以学易，可以无大过矣。",
    "book": "论语",
    "chapter": "述而",
    "speaker": "孔子",
    "id": "dq-207fbbc4"
  },
  {
    "text": "默而识之，学而不厌，诲人不倦，何有于我哉。",
    "book": "论语",
    "chapter": "述而",
    "speaker": "孔子",
    "id": "dq-bd82ee74"
  },
  {
    "text": "三人行，必有我师焉。",
    "book": "论语",
    "chapter": "述而",
    "speaker": "孔子",
    "id": "dq-a26e4e02"
  },
  {
    "text": "君子坦荡荡，小人长戚戚。",
    "book": "论语",
    "chapter": "述而",
    "speaker": "孔子",
    "id": "dq-fcd788d5"
  },
  {
    "text": "择其善者而从之，其不善者而改之。",
    "book": "论语",
    "chapter": "述而",
    "speaker": "孔子",
    "id": "dq-9db11b68"
  },
  {
    "text": "子温而厉，威而不猛，恭而安。",
    "book": "论语",
    "chapter": "述而",
    "id": "dq-1b1f8fbc"
  },
  {
    "text": "子以四教：文、行、忠、信。",
    "book": "论语",
    "chapter": "述而",
    "id": "dq-606ec103"
  },
  {
    "text": "子与人歌而善，必使反之，而后和之。",
    "book": "论语",
    "chapter": "述而",
    "id": "dq-dd65b420"
  },
  {
    "text": "往者不可谏，来者犹可追。",
    "book": "论语",
    "chapter": "微子",
    "id": "dq-29605130"
  },
  {
    "text": "己所不欲，勿施于人。",
    "book": "论语",
    "chapter": "卫灵公",
    "speaker": "孔子",
    "id": "dq-598f5545"
  },
  {
    "text": "工欲善其事，必先利其器。",
    "book": "论语",
    "chapter": "卫灵公",
    "speaker": "孔子",
    "id": "dq-bc946454"
  },
  {
    "text": "居是邦也，事其大夫之贤者，友其士之仁者。",
    "book": "论语",
    "chapter": "卫灵公",
    "speaker": "孔子",
    "id": "dq-9b56b654"
  },
  {
    "text": "君子义以为质，礼以行之，孙以出之，信以成之。",
    "book": "论语",
    "chapter": "卫灵公",
    "speaker": "孔子",
    "id": "dq-e9fdb496"
  },
  {
    "text": "群居终日，言不及义，好行小慧，难矣哉。",
    "book": "论语",
    "chapter": "卫灵公",
    "speaker": "孔子",
    "id": "dq-eb29aaf8"
  },
  {
    "text": "言不忠信，行不笃敬，虽州里行乎哉。",
    "book": "论语",
    "chapter": "卫灵公",
    "speaker": "孔子",
    "id": "dq-7729e2b7"
  },
  {
    "text": "言忠信，行笃敬，虽蛮貊之邦行矣。",
    "book": "论语",
    "chapter": "卫灵公",
    "speaker": "孔子",
    "id": "dq-2d3afdce"
  },
  {
    "text": "视其所以，观其所由，察其所安，人焉廋哉。",
    "book": "论语",
    "chapter": "为政",
    "speaker": "孔子",
    "id": "dq-6e11fe68"
  },
  {
    "text": "为政以德，譬如北辰，居其所，而众星共之。",
    "book": "论语",
    "chapter": "为政",
    "speaker": "孔子",
    "id": "dq-bbea1ec6"
  },
  {
    "text": "学而不思则罔，思而不学则殆。",
    "book": "论语",
    "chapter": "为政",
    "speaker": "孔子",
    "id": "dq-eba93631"
  },
  {
    "text": "温故而知新，可以为师矣。",
    "book": "论语",
    "chapter": "为政",
    "speaker": "孔子",
    "id": "dq-83bf6713"
  },
  {
    "text": "知之为知之，不知为不知，是知也。",
    "book": "论语",
    "chapter": "为政",
    "speaker": "孔子",
    "id": "dq-24276832"
  },
  {
    "text": "过犹不及。",
    "book": "论语",
    "chapter": "先进",
    "speaker": "孔子",
    "id": "dq-95447b67"
  },
  {
    "text": "所谓大臣者，以道事君，不可则止。",
    "book": "论语",
    "chapter": "先进",
    "speaker": "孔子",
    "id": "dq-cca5108e"
  },
  {
    "text": "古之学者为己，今之学者为人。",
    "book": "论语",
    "chapter": "宪问",
    "speaker": "孔子",
    "id": "dq-2d3a2ee4"
  },
  {
    "text": "仁者必有勇，勇者不必有仁。",
    "book": "论语",
    "chapter": "宪问",
    "speaker": "孔子",
    "id": "dq-565acb30"
  },
  {
    "text": "有德者必有言，有言者不必有德。",
    "book": "论语",
    "chapter": "宪问",
    "speaker": "孔子",
    "id": "dq-f0f1300a"
  },
  {
    "text": "道千乘之国，敬事而信，节用而爱人，使民以时。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "孔子",
    "id": "dq-9fd7b7a3"
  },
  {
    "text": "弟子入则孝，出则弟，谨而信，泛爱众，而亲仁。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "孔子",
    "id": "dq-4c6834e8"
  },
  {
    "text": "君子不重则不威，学则不固。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "孔子",
    "id": "dq-136c65dd"
  },
  {
    "text": "三年无改于父之道，可谓孝矣。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "孔子",
    "id": "dq-67dc4d4d"
  },
  {
    "text": "孝弟也者，其为仁之本与。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "有子",
    "id": "dq-12bc7875"
  },
  {
    "text": "有朋自远方来，不亦乐乎。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "孔子",
    "id": "dq-4d20c5b8"
  },
  {
    "text": "主忠信，无友不如己者，过则勿惮改。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "孔子",
    "id": "dq-5c6d8f67"
  },
  {
    "text": "非礼勿视，非礼勿听，非礼勿言，非礼勿动。",
    "book": "论语",
    "chapter": "颜渊",
    "speaker": "孔子",
    "id": "dq-6619cd99"
  },
  {
    "text": "君子成人之美，不成人之恶。",
    "book": "论语",
    "chapter": "颜渊",
    "speaker": "孔子",
    "id": "dq-8c0c7aac"
  },
  {
    "text": "一日克己复礼，天下归仁焉，为仁由己，而由人乎哉。",
    "book": "论语",
    "chapter": "颜渊",
    "speaker": "孔子",
    "id": "dq-c5cec406"
  },
  {
    "text": "恭则不侮，宽则得众，信则人任焉，敏则有功，惠则足以使人。",
    "book": "论语",
    "chapter": "阳货",
    "speaker": "孔子",
    "id": "dq-ca696784"
  },
  {
    "text": "性相近也，习相远也。",
    "book": "论语",
    "chapter": "阳货",
    "speaker": "孔子",
    "id": "dq-3730f8be"
  },
  {
    "text": "夫仁者，己欲立而立人，己欲达而达人。",
    "book": "论语",
    "chapter": "雍也",
    "speaker": "孔子",
    "id": "dq-9d8464a4"
  },
  {
    "text": "居敬而行简，以临其民，不亦可乎。",
    "book": "论语",
    "chapter": "雍也",
    "id": "dq-dcbe8d2c"
  },
  {
    "text": "君子博学于文，约之以礼，亦可以弗畔矣夫。",
    "book": "论语",
    "chapter": "雍也",
    "speaker": "孔子",
    "id": "dq-9196aee8"
  },
  {
    "text": "能近取譬，可谓仁之方也已。",
    "book": "论语",
    "chapter": "雍也",
    "speaker": "孔子",
    "id": "dq-07d76475"
  },
  {
    "text": "仁者先难而后获，可谓仁矣。",
    "book": "论语",
    "chapter": "雍也",
    "speaker": "孔子",
    "id": "dq-dcb196a8"
  },
  {
    "text": "知之者，不如好之者，好之者，不如乐之者。",
    "book": "论语",
    "chapter": "雍也",
    "speaker": "孔子",
    "id": "dq-f6f34b0e"
  },
  {
    "text": "夫子循循然善诱人：博我以文，约我以礼。",
    "book": "论语",
    "chapter": "子罕",
    "id": "dq-1a14c364"
  },
  {
    "text": "欲速，则不达。见小利，则大事不成。",
    "book": "论语",
    "chapter": "子路",
    "speaker": "孔子",
    "id": "dq-b518b6e4"
  },
  {
    "text": "君子和而不同，小人同而不和。",
    "book": "论语",
    "chapter": "子路",
    "speaker": "孔子",
    "id": "dq-59de9eb9"
  },
  {
    "text": "其身正，不令而行。",
    "book": "论语",
    "chapter": "子路",
    "speaker": "孔子",
    "id": "dq-44124d7a"
  },
  {
    "text": "百工居肆以成其事，君子学以致其道。",
    "book": "论语",
    "chapter": "子张",
    "speaker": "子夏",
    "id": "dq-a5b884f2"
  },
  {
    "text": "博学而笃志，切问而近思，仁在其中矣。",
    "book": "论语",
    "chapter": "子张",
    "speaker": "子夏",
    "id": "dq-da5282b9"
  },
  {
    "text": "大德不逾闲，小德出入可也。",
    "book": "论语",
    "chapter": "子张",
    "speaker": "子夏",
    "id": "dq-b8e99777"
  },
  {
    "text": "君子信而后劳其民，未信则以为厉己也。",
    "book": "论语",
    "chapter": "子张",
    "speaker": "子夏",
    "id": "dq-717566c1"
  },
  {
    "text": "君子尊贤而容众，嘉善而矜不能。",
    "book": "论语",
    "chapter": "子张",
    "speaker": "子张",
    "id": "dq-2901e6eb"
  },
  {
    "text": "虽小道，必有可观者焉，致远恐泥，是以君子不为也。",
    "book": "论语",
    "chapter": "子张",
    "speaker": "子夏",
    "id": "dq-7264d853"
  },
  {
    "text": "鱼，我所欲也。熊掌，亦我所欲也。",
    "book": "孟子",
    "chapter": "告子上",
    "speaker": "孟子",
    "id": "dq-c89e58d9"
  },
  {
    "text": "学问之道无他，求其放心而已矣。",
    "book": "孟子",
    "chapter": "告子上",
    "speaker": "孟子",
    "id": "dq-23d617f9"
  },
  {
    "text": "人性之无分于善不善也，犹水之无分于东西也。",
    "book": "孟子",
    "chapter": "告子上",
    "speaker": "告子",
    "id": "dq-5cfe7657"
  },
  {
    "text": "仁义礼智，非由外铄我也，我固有之也，弗思耳矣。",
    "book": "孟子",
    "chapter": "告子上",
    "speaker": "孟子",
    "id": "dq-ada2e754"
  },
  {
    "text": "夫茍好善，则四海之内，皆将轻千里而来告之以善。",
    "book": "孟子",
    "chapter": "告子下",
    "id": "dq-5ab7ce98"
  },
  {
    "text": "君子之事君也，务引其君以当道，志于仁而已。",
    "book": "孟子",
    "chapter": "告子下",
    "id": "dq-64611fc4"
  },
  {
    "text": "人恒过，然后能改。",
    "book": "孟子",
    "chapter": "告子下",
    "speaker": "孟子",
    "id": "dq-ad99b9fe"
  },
  {
    "text": "大舜有大焉，善与人同，舍己从人，乐取于人以为善。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "speaker": "孟子",
    "id": "dq-3e27fa7e"
  },
  {
    "text": "我善养吾浩然之气。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "speaker": "孟子",
    "id": "dq-b940bf86"
  },
  {
    "text": "地不改辟矣，民不改聚矣，行仁政而王，莫之能御也。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "id": "dq-f0ed6211"
  },
  {
    "text": "自反而缩，虽千万人吾往矣。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "speaker": "孟子",
    "id": "dq-e1a2473a"
  },
  {
    "text": "信能行此五者，则邻国之民仰之若父母矣。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "speaker": "孟子",
    "id": "dq-8e130d99"
  },
  {
    "text": "以德服人者，中心悦而诚服也，如七十子之服孔子也。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "speaker": "孟子",
    "id": "dq-906fcfdc"
  },
  {
    "text": "以德行仁者王，王不待大，汤以七十里，文王以百里。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "speaker": "孟子",
    "id": "dq-6d9baee6"
  },
  {
    "text": "朝廷莫如爵，乡党莫如齿，辅世长民莫如德。",
    "book": "孟子",
    "chapter": "公孙丑下",
    "id": "dq-ec0ef0ab"
  },
  {
    "text": "天时不如地利，地利不如人和。",
    "book": "孟子",
    "chapter": "公孙丑下",
    "speaker": "孟子",
    "id": "dq-14926692"
  },
  {
    "text": "得道者多助，失道者寡助。",
    "book": "孟子",
    "chapter": "公孙丑下",
    "speaker": "孟子",
    "id": "dq-35fba86b"
  },
  {
    "text": "道则高矣、美矣，宜若登天然，似不可及也。",
    "book": "孟子",
    "chapter": "尽心上",
    "id": "dq-1d864e2a"
  },
  {
    "text": "孩提之童，无不知爱其亲者，及其长也，无不知敬其兄也。",
    "book": "孟子",
    "chapter": "尽心上",
    "speaker": "孟子",
    "id": "dq-40f6ef37"
  },
  {
    "text": "及其闻一善言，见一善行，若决江河，沛然莫之能御也。",
    "book": "孟子",
    "chapter": "尽心上",
    "speaker": "孟子",
    "id": "dq-96948ec5"
  },
  {
    "text": "穷则独善其身。达则兼善天下。",
    "book": "孟子",
    "chapter": "尽心上",
    "id": "dq-64730c74"
  },
  {
    "text": "求之有道，得之有命，是求无益于得也，求在外者也。",
    "book": "孟子",
    "chapter": "尽心上",
    "speaker": "孟子",
    "id": "dq-3995c043"
  },
  {
    "text": "行之而不著焉，习矣而不察焉，终身由之而不知其道者，众也。",
    "book": "孟子",
    "chapter": "尽心上",
    "speaker": "孟子",
    "id": "dq-2663a1c0"
  },
  {
    "text": "尽信《书》，则不如无《书》。",
    "book": "孟子",
    "chapter": "尽心下",
    "speaker": "孟子",
    "id": "dq-d138de15"
  },
  {
    "text": "行有不得者，皆反求诸己。",
    "book": "孟子",
    "chapter": "离娄上",
    "speaker": "孟子",
    "id": "dq-dee9f822"
  },
  {
    "text": "君仁莫不仁，君义莫不义，君正莫不正，一正君而国定矣。",
    "book": "孟子",
    "chapter": "离娄上",
    "speaker": "孟子",
    "id": "dq-17f157f4"
  },
  {
    "text": "爱人者，人恒爱之。敬人者，人恒敬之。",
    "book": "孟子",
    "chapter": "离娄下",
    "speaker": "孟子",
    "id": "dq-ac490781"
  },
  {
    "text": "大人者，言不必信，行不必果，惟义所在。",
    "book": "孟子",
    "chapter": "离娄下",
    "speaker": "孟子",
    "id": "dq-c42c632c"
  },
  {
    "text": "人有不为也，而后可以有为。",
    "book": "孟子",
    "chapter": "离娄下",
    "speaker": "孟子",
    "id": "dq-73bbe76b"
  },
  {
    "text": "中也养不中，才也养不才，故人乐有贤父兄也。",
    "book": "孟子",
    "chapter": "离娄下",
    "speaker": "孟子",
    "id": "dq-cca32c70"
  },
  {
    "text": "自得之则居之安，居之安则资之深，资之深则取之左右逢其原。",
    "book": "孟子",
    "chapter": "离娄下",
    "speaker": "孟子",
    "id": "dq-547d7483"
  },
  {
    "text": "老吾老，以及人之老。幼吾幼，以及人之幼。",
    "book": "孟子",
    "chapter": "梁惠王上",
    "id": "dq-70888a66"
  },
  {
    "text": "古之人所以大过人者，无他焉，善推其所为而已矣。",
    "book": "孟子",
    "chapter": "梁惠王上",
    "id": "dq-f430abfc"
  },
  {
    "text": "谨庠序之教，申之以孝悌之义，颁白者不负戴于道路矣。",
    "book": "孟子",
    "chapter": "梁惠王上",
    "speaker": "孟子",
    "id": "dq-bebf7462"
  },
  {
    "text": "是故明君制民之产，必使仰足以事父母，俯足以畜妻子。",
    "book": "孟子",
    "chapter": "梁惠王上",
    "id": "dq-be72c8b1"
  },
  {
    "text": "未有仁而遗其亲者也，未有义而后其君者也。",
    "book": "孟子",
    "chapter": "梁惠王上",
    "speaker": "孟子",
    "id": "dq-c1b62de3"
  },
  {
    "text": "权，然后知轻重。度，然后知长短。",
    "book": "孟子",
    "chapter": "梁惠王上",
    "id": "dq-41a79964"
  },
  {
    "text": "壮者以暇日修其孝悌忠信，入以事其父兄，出以事其长上。",
    "book": "孟子",
    "chapter": "梁惠王上",
    "speaker": "孟子",
    "id": "dq-1515b997"
  },
  {
    "text": "乐民之乐者，民亦乐其乐。",
    "book": "孟子",
    "chapter": "梁惠王下",
    "speaker": "孟子",
    "id": "dq-b19ccb01"
  },
  {
    "text": "分人以财谓之惠，教人以善谓之忠，为天下得人者谓之仁。",
    "book": "孟子",
    "chapter": "滕文公上",
    "id": "dq-31844f8f"
  },
  {
    "text": "有为者亦若是。",
    "book": "孟子",
    "chapter": "滕文公上",
    "speaker": "孟子",
    "id": "dq-fad20218"
  },
  {
    "text": "民之为道也，有恒产者有恒心，无恒产者无恒心。",
    "book": "孟子",
    "chapter": "滕文公上",
    "speaker": "孟子",
    "id": "dq-35d3d097"
  },
  {
    "text": "居天下之广居，立天下之正位，行天下之大道。",
    "book": "孟子",
    "chapter": "滕文公下",
    "speaker": "孟子",
    "id": "dq-fee1945e"
  },
  {
    "text": "大孝终身慕父母，五十而慕者，予于大舜见之矣。",
    "book": "孟子",
    "chapter": "万章上",
    "id": "dq-e034cadf"
  },
  {
    "text": "非其义也，非其道也，禄之以天下弗顾也，系马千驷弗视也。",
    "book": "孟子",
    "chapter": "万章上",
    "speaker": "孟子",
    "id": "dq-798ca812"
  },
  {
    "text": "非其义也，非其道也，一介不以与人，一介不以取诸人。",
    "book": "孟子",
    "chapter": "万章上",
    "speaker": "孟子",
    "id": "dq-4aa963e1"
  },
  {
    "text": "以意逆志，是为得之。",
    "book": "孟子",
    "chapter": "万章上",
    "id": "dq-e615447d"
  },
  {
    "text": "友也者，友其德也，不可以有挟也。",
    "book": "孟子",
    "chapter": "万章下",
    "speaker": "孟子",
    "id": "dq-8b2c5573"
  },
  {
    "text": "欲见贤人而不以其道，犹欲其入而闭之门也。",
    "book": "孟子",
    "chapter": "万章下",
    "id": "dq-260bdd4e"
  },
  {
    "text": "行有余力，则以学文。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "孔子",
    "id": "dq-dec86108"
  },
  {
    "text": "与朋友交，言而有信。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "子夏",
    "id": "dq-b7a293ba"
  },
  {
    "text": "信近于义，言可复也。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "有子",
    "id": "dq-ad3495b8"
  },
  {
    "text": "今之孝者，是谓能养。",
    "book": "论语",
    "chapter": "为政",
    "speaker": "孔子",
    "id": "dq-1ac0f012"
  },
  {
    "text": "举善而教不能，则劝。",
    "book": "论语",
    "chapter": "为政",
    "speaker": "孔子",
    "id": "dq-802744c4"
  },
  {
    "text": "礼，与其奢也，宁俭。",
    "book": "论语",
    "chapter": "八佾",
    "speaker": "孔子",
    "id": "dq-3a92b1b6"
  },
  {
    "text": "尔爱其羊，我爱其礼。",
    "book": "论语",
    "chapter": "八佾",
    "speaker": "孔子",
    "id": "dq-b33e7534"
  },
  {
    "text": "仁者安仁，知者利仁。",
    "book": "论语",
    "chapter": "里仁",
    "speaker": "孔子",
    "id": "dq-c5f25025"
  },
  {
    "text": "甯武子，邦有道则知。",
    "book": "论语",
    "chapter": "公冶长",
    "speaker": "孔子",
    "id": "dq-f118851c"
  },
  {
    "text": "孟武伯问：子路仁乎。",
    "book": "论语",
    "chapter": "公冶长",
    "id": "dq-f1cddad1"
  },
  {
    "text": "力不足者，中道而废。",
    "book": "论语",
    "chapter": "雍也",
    "speaker": "孔子",
    "id": "dq-305eb8f9"
  },
  {
    "text": "知者乐水，仁者乐山。",
    "book": "论语",
    "chapter": "雍也",
    "speaker": "孔子",
    "id": "dq-15b1a9f7"
  },
  {
    "text": "何事于仁，必也圣乎。",
    "book": "论语",
    "chapter": "雍也",
    "speaker": "孔子",
    "id": "dq-d9325f1c"
  },
  {
    "text": "不图为乐之至于斯也。",
    "book": "论语",
    "chapter": "述而",
    "id": "dq-cbd59855"
  },
  {
    "text": "学如不及，犹恐失之。",
    "book": "论语",
    "chapter": "泰伯",
    "speaker": "孔子",
    "id": "dq-491be3a7"
  },
  {
    "text": "可与适道，未可与立。",
    "book": "论语",
    "chapter": "子罕",
    "speaker": "孔子",
    "id": "dq-f6c0af2b"
  },
  {
    "text": "先进于礼乐，野人也。",
    "book": "论语",
    "chapter": "先进",
    "speaker": "孔子",
    "id": "dq-3fa71bfb"
  },
  {
    "text": "后进于礼乐，君子也。",
    "book": "论语",
    "chapter": "先进",
    "speaker": "孔子",
    "id": "dq-ee1a9cfe"
  },
  {
    "text": "如其礼乐，以俟君子。",
    "book": "论语",
    "chapter": "先进",
    "id": "dq-db9d7b46"
  },
  {
    "text": "博学以文，约之以礼。",
    "book": "论语",
    "chapter": "颜渊",
    "speaker": "孔子",
    "id": "dq-a92afede"
  },
  {
    "text": "先事后得，非崇德与。",
    "book": "论语",
    "chapter": "颜渊",
    "speaker": "孔子",
    "id": "dq-36a918c0"
  },
  {
    "text": "事不成，则礼乐不兴。",
    "book": "论语",
    "chapter": "子路",
    "speaker": "孔子",
    "id": "dq-a814d14d"
  },
  {
    "text": "说之不以道，不说也。",
    "book": "论语",
    "chapter": "子路",
    "speaker": "孔子",
    "id": "dq-e56cee45"
  },
  {
    "text": "说之虽不以道，说也。",
    "book": "论语",
    "chapter": "子路",
    "speaker": "孔子",
    "id": "dq-56166f03"
  },
  {
    "text": "道之将行也与，命也。",
    "book": "论语",
    "chapter": "宪问",
    "speaker": "孔子",
    "id": "dq-9062cd97"
  },
  {
    "text": "道之将废也与，命也。",
    "book": "论语",
    "chapter": "宪问",
    "speaker": "孔子",
    "id": "dq-714539f2"
  },
  {
    "text": "上好礼，则民易使也。",
    "book": "论语",
    "chapter": "宪问",
    "speaker": "孔子",
    "id": "dq-2a93154c"
  },
  {
    "text": "子言衞灵公之无道也。",
    "book": "论语",
    "chapter": "宪问",
    "id": "dq-5e7071e8"
  },
  {
    "text": "军旅之事，未之学也。",
    "book": "论语",
    "chapter": "卫灵公",
    "speaker": "孔子",
    "id": "dq-7ead5fdc"
  },
  {
    "text": "人能弘道，非道弘人。",
    "book": "论语",
    "chapter": "卫灵公",
    "speaker": "孔子",
    "id": "dq-74a1aea5"
  },
  {
    "text": "动之不以礼，未善也。",
    "book": "论语",
    "chapter": "卫灵公",
    "speaker": "孔子",
    "id": "dq-675dca04"
  },
  {
    "text": "困而学之，又其次也。",
    "book": "论语",
    "chapter": "季氏",
    "speaker": "孔子",
    "id": "dq-09888e35"
  },
  {
    "text": "不学《诗》，无以言。",
    "book": "论语",
    "chapter": "季氏",
    "id": "dq-9d85e308"
  },
  {
    "text": "三年不为乐，乐必崩。",
    "book": "论语",
    "chapter": "阳货",
    "id": "dq-4a3e2d18"
  },
  {
    "text": "君子之道，焉可诬也。",
    "book": "论语",
    "chapter": "子张",
    "id": "dq-220763d0"
  },
  {
    "text": "上失其道，民散久矣。",
    "book": "论语",
    "chapter": "子张",
    "speaker": "曾子",
    "id": "dq-09ba0588"
  },
  {
    "text": "欲仁而得仁，又焉贪。",
    "book": "论语",
    "chapter": "尧曰",
    "speaker": "孔子",
    "id": "dq-58eb5d95"
  },
  {
    "text": "周有大赉，善人是富。",
    "book": "论语",
    "chapter": "尧曰",
    "id": "dq-3e049aed"
  },
  {
    "text": "虽有周亲，不如仁人。",
    "book": "论语",
    "chapter": "尧曰",
    "id": "dq-39f8b1f1"
  },
  {
    "text": "德何如，则可以王矣。",
    "book": "孟子",
    "chapter": "梁惠王上",
    "id": "dq-45932fe5"
  },
  {
    "text": "今之乐，犹古之乐也。",
    "book": "孟子",
    "chapter": "梁惠王下",
    "id": "dq-7fda5011"
  },
  {
    "text": "此无他，与民同乐也。",
    "book": "孟子",
    "chapter": "梁惠王下",
    "id": "dq-725995a7"
  },
  {
    "text": "仁且智，夫子既圣矣。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "id": "dq-391037d8"
  },
  {
    "text": "恻隐之心，仁之端也。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "speaker": "孟子",
    "id": "dq-6a45a79b"
  },
  {
    "text": "辞让之心，礼之端也。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "speaker": "孟子",
    "id": "dq-1453a7ea"
  },
  {
    "text": "是非之心，智之端也。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "speaker": "孟子",
    "id": "dq-aa530fa4"
  },
  {
    "text": "进不隐贤，必以其道。",
    "book": "孟子",
    "chapter": "公孙丑上",
    "speaker": "孟子",
    "id": "dq-5a27c8bb"
  },
  {
    "text": "父子主恩，君臣主敬。",
    "book": "孟子",
    "chapter": "公孙丑下",
    "speaker": "景子",
    "id": "dq-2349f3b6"
  },
  {
    "text": "彼以其富，我以吾仁。",
    "book": "孟子",
    "chapter": "公孙丑下",
    "id": "dq-9620146f"
  },
  {
    "text": "所以为蚔蛙，则善矣。",
    "book": "孟子",
    "chapter": "公孙丑下",
    "id": "dq-0ef55b25"
  },
  {
    "text": "设为庠序学校以教之。",
    "book": "孟子",
    "chapter": "滕文公上",
    "speaker": "孟子",
    "id": "dq-ed1159df"
  },
  {
    "text": "如枉道而从彼，何也。",
    "book": "孟子",
    "chapter": "滕文公下",
    "id": "dq-97521e29"
  },
  {
    "text": "朝不信道，工不信度。",
    "book": "孟子",
    "chapter": "离娄上",
    "speaker": "孟子",
    "id": "dq-d031bab2"
  },
  {
    "text": "是故诚者，天之道也。",
    "book": "孟子",
    "chapter": "离娄上",
    "speaker": "孟子",
    "id": "dq-90d47648"
  },
  {
    "text": "不诚，未有能动者也。",
    "book": "孟子",
    "chapter": "离娄上",
    "speaker": "孟子",
    "id": "dq-d65acf64"
  },
  {
    "text": "男女授受不亲，礼与。",
    "book": "孟子",
    "chapter": "离娄上",
    "id": "dq-52fb4b7d"
  },
  {
    "text": "乐正子从于子敖之齐。",
    "book": "孟子",
    "chapter": "离娄上",
    "id": "dq-224d71c9"
  },
  {
    "text": "信斯言也，宜莫如舜。",
    "book": "孟子",
    "chapter": "万章上",
    "id": "dq-167aaf1b"
  },
  {
    "text": "不识此语，诚然乎哉。",
    "book": "孟子",
    "chapter": "万章上",
    "id": "dq-3ae8be8c"
  },
  {
    "text": "柳下惠，圣之和者也。",
    "book": "孟子",
    "chapter": "万章下",
    "speaker": "孟子",
    "id": "dq-dabcd444"
  },
  {
    "text": "始条理者，智之事也。",
    "book": "孟子",
    "chapter": "万章下",
    "speaker": "孟子",
    "id": "dq-441d007e"
  },
  {
    "text": "用下敬上，谓之贵贵。",
    "book": "孟子",
    "chapter": "万章下",
    "speaker": "孟子",
    "id": "dq-abe26c17"
  },
  {
    "text": "用上敬下，谓之尊贤。",
    "book": "孟子",
    "chapter": "万章下",
    "speaker": "孟子",
    "id": "dq-ffae06d3"
  },
  {
    "text": "予将以此道觉此民也。",
    "book": "孟子",
    "chapter": "万章下",
    "id": "dq-eae78e13"
  },
  {
    "text": "行吾敬，故谓之内也。",
    "book": "孟子",
    "chapter": "告子上",
    "id": "dq-b8685085"
  },
  {
    "text": "恭敬之心，人皆有之。",
    "book": "孟子",
    "chapter": "告子上",
    "speaker": "孟子",
    "id": "dq-9473afd3"
  },
  {
    "text": "民之秉彝，好是懿德。",
    "book": "孟子",
    "chapter": "告子上",
    "speaker": "孟子",
    "id": "dq-5e3701d4"
  },
  {
    "text": "所敬在此，所长在彼。",
    "book": "孟子",
    "chapter": "告子上",
    "id": "dq-063f91b3"
  },
  {
    "text": "其知者以为为无礼也。",
    "book": "孟子",
    "chapter": "告子下",
    "id": "dq-0399fc83"
  },
  {
    "text": "禹之治水，水之道也。",
    "book": "孟子",
    "chapter": "告子下",
    "speaker": "孟子",
    "id": "dq-eab18e09"
  },
  {
    "text": "爱而不敬，兽畜之也。",
    "book": "孟子",
    "chapter": "尽心上",
    "speaker": "孟子",
    "id": "dq-160187c3"
  },
  {
    "text": "中道而立，能者从之。",
    "book": "孟子",
    "chapter": "尽心上",
    "speaker": "孟子",
    "id": "dq-5f982808"
  },
  {
    "text": "天下有道，以道殉身。",
    "book": "孟子",
    "chapter": "尽心上",
    "speaker": "孟子",
    "id": "dq-8b582706"
  },
  {
    "text": "天下无道，以身殉道。",
    "book": "孟子",
    "chapter": "尽心上",
    "speaker": "孟子",
    "id": "dq-4ac389cb"
  },
  {
    "text": "未闻以道殉乎人者也。",
    "book": "孟子",
    "chapter": "尽心上",
    "speaker": "孟子",
    "id": "dq-5368106c"
  },
  {
    "text": "于民也，仁之而弗亲。",
    "book": "孟子",
    "chapter": "尽心上",
    "speaker": "孟子",
    "id": "dq-82165e43"
  },
  {
    "text": "不信仁贤，则国空虚。",
    "book": "孟子",
    "chapter": "尽心下",
    "speaker": "孟子",
    "id": "dq-3868daf4"
  },
  {
    "text": "如切如磋者，道学也。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-7ab37751"
  },
  {
    "text": "德者本也，财者末也。",
    "book": "礼记",
    "chapter": "大学",
    "id": "dq-f91eee8a"
  },
  {
    "text": "庸德之行，庸言之谨。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-d6ea4315"
  },
  {
    "text": "兄弟既翕，和乐且耽。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-32563783"
  },
  {
    "text": "宜尔室家，乐尔妻帑。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-d04a26f8"
  },
  {
    "text": "人道敏政，地道敏树。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-b9256df8"
  },
  {
    "text": "仁者人也，亲亲为大。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-981d5f6e"
  },
  {
    "text": "义者宜也，尊贤为大。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-6c532332"
  },
  {
    "text": "诚则明矣，明则诚矣。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-e7d6ddf2"
  },
  {
    "text": "至诚之道，可以前知。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-02caee4b"
  },
  {
    "text": "吾学殷礼，有宋存焉。",
    "book": "礼记",
    "chapter": "中庸",
    "speaker": "孔子",
    "id": "dq-417b2bb8"
  },
  {
    "text": "发而皆中节，谓之和。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-dec9f1fe"
  },
  {
    "text": "国有道，其言足以兴。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-e827cbfd"
  },
  {
    "text": "国无道，其默足以容。",
    "book": "礼记",
    "chapter": "中庸",
    "id": "dq-8b798baf"
  },
  {
    "text": "信不足焉，有不信焉。",
    "book": "道德经",
    "chapter": "第十七章",
    "speaker": "老子",
    "id": "dq-6ca2c9d0"
  },
  {
    "text": "不善人者，善人之资。",
    "book": "道德经",
    "chapter": "第二十七章",
    "speaker": "老子",
    "id": "dq-e1871cfd"
  },
  {
    "text": "修之于家，其德乃余。",
    "book": "道德经",
    "chapter": "第五十四章",
    "speaker": "老子",
    "id": "dq-5da78d4c"
  },
  {
    "text": "修之于乡，其德乃长。",
    "book": "道德经",
    "chapter": "第五十四章",
    "speaker": "老子",
    "id": "dq-53d9e78b"
  },
  {
    "text": "修之于国，其德乃丰。",
    "book": "道德经",
    "chapter": "第五十四章",
    "speaker": "老子",
    "id": "dq-44c2a334"
  },
  {
    "text": "正复为奇，善复为妖。",
    "book": "道德经",
    "chapter": "第五十八章",
    "speaker": "老子",
    "id": "dq-94b2b27c"
  },
  {
    "text": "人之不善，何弃之有。",
    "book": "道德经",
    "chapter": "第六十二章",
    "speaker": "老子",
    "id": "dq-cbf139d6"
  },
  {
    "text": "古之所以贵此道者何。",
    "book": "道德经",
    "chapter": "第六十二章",
    "speaker": "老子",
    "id": "dq-b89b449e"
  },
  {
    "text": "民之难治，以其智多。",
    "book": "道德经",
    "chapter": "第六十五章",
    "speaker": "老子",
    "id": "dq-7cac66ea"
  },
  {
    "text": "常知稽式，是谓玄德。",
    "book": "道德经",
    "chapter": "第六十五章",
    "speaker": "老子",
    "id": "dq-8dd45666"
  },
  {
    "text": "学而时习之，不亦说乎。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "孔子",
    "id": "dq-319924d6"
  },
  {
    "text": "君子务本，本立而道生。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "有子",
    "id": "dq-ae3eb22d"
  },
  {
    "text": "愼终追远，民德归厚矣。",
    "book": "论语",
    "chapter": "学而",
    "speaker": "曾子",
    "id": "dq-9b547cb0"
  },
  {
    "text": "人而无信，不知其可也。",
    "book": "论语",
    "chapter": "为政",
    "speaker": "孔子",
    "id": "dq-4ef8e0c6"
  },
  {
    "text": "事君尽礼，人以为谄也。",
    "book": "论语",
    "chapter": "八佾",
    "speaker": "孔子",
    "id": "dq-8b33a170"
  },
  {
    "text": "不以其道得之，不去也。",
    "book": "论语",
    "chapter": "里仁",
    "speaker": "孔子",
    "id": "dq-743276d1"
  },
  {
    "text": "能以礼让为国乎，何有。",
    "book": "论语",
    "chapter": "里仁",
    "speaker": "孔子",
    "id": "dq-c3da1c03"
  },
  {
    "text": "夫子之道，忠恕而已矣。",
    "book": "论语",
    "chapter": "里仁",
    "speaker": "曾子",
    "id": "dq-cc2db58a"
  },
  {
    "text": "回也，其心三月不违仁。",
    "book": "论语",
    "chapter": "雍也",
    "speaker": "孔子",
    "id": "dq-536e80f2"
  },
  {
    "text": "善人，吾不得而见之矣。",
    "book": "论语",
    "chapter": "述而",
    "speaker": "孔子",
    "id": "dq-10ee1695"
  },
  {
    "text": "陈司败问：昭公知礼乎。",
    "book": "论语",
    "chapter": "述而",
    "id": "dq-1cb394c3"
  },
  {
    "text": "仁以为己任，不亦重乎。",
    "book": "论语",
    "chapter": "泰伯",
    "speaker": "曾子",
    "id": "dq-28558435"
  },
  {
    "text": "曾子有疾，孟敬子问之。",
    "book": "论语",
    "chapter": "泰伯",
    "id": "dq-e214201c"
  },
  {
    "text": "吾未见好德如好色者也。",
    "book": "论语",
    "chapter": "子罕",
    "speaker": "孔子",
    "id": "dq-bd07d95b"
  },
  {
    "text": "可与共学，未可与适道。",
    "book": "论语",
    "chapter": "子罕",
    "speaker": "孔子",
    "id": "dq-a51c1225"
  },
  {
    "text": "主忠信，徙义：崇德也。",
    "book": "论语",
    "chapter": "颜渊",
    "speaker": "孔子",
    "id": "dq-3c79ffa3"
  },
  {
    "text": "（诚不以富，亦祇以异。",
    "book": "论语",
    "chapter": "颜渊",
    "id": "dq-6ad8ad50"
  },
  {
    "text": "上好礼，则民莫敢不敬。",
    "book": "论语",
    "chapter": "子路",
    "speaker": "孔子",
    "id": "dq-e40d39dc"
  },
  {
    "text": "上好义，则民莫敢不服。",
    "book": "论语",
    "chapter": "子路",
    "speaker": "孔子",
    "id": "dq-7a24b4f6"
  },
  {
    "text": "如有王者，必世而后仁。",
    "book": "论语",
    "chapter": "子路",
    "speaker": "孔子",
    "id": "dq-5aa0e87a"
  },
  {
    "text": "乐然后笑，人不厌其笑。",
    "book": "论语",
    "chapter": "宪问",
    "id": "dq-10a001a1"
  },
  {
    "text": "义然后取，人不厌其取。",
    "book": "论语",
    "chapter": "宪问",
    "id": "dq-682f23a2"
  },
  {
    "text": "骥不称其力，称其德也。",
    "book": "论语",
    "chapter": "宪问",
    "speaker": "孔子",
    "id": "dq-4ac5a59b"
  }
]
