{
  "note": "Rick 抽检的 18 条误署。检查必须拒绝「这句话 + 这个署名」，即使快照的引号把它们圈进了较长的子曰。",
  "cases": [
    {"id": "dq-7bab6cdd", "text": "博厚配地，高明配天，悠久无疆。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-e9832f7c", "text": "不息则久，久则征，征则悠远，悠远则博厚，博厚则高明。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-9e36ac90", "text": "天地之道，可壹言而尽也。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-bd020ab9", "text": "天地之道：博也，厚也，高也，明也，悠也，久也。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-cde46a9e", "text": "于乎不显，文王之德之纯。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-658a5dc3", "text": "诚者，物之终始，不诚无物。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-6bd8777f", "text": "诚者非自成己而已也，所以成物也。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-6333414b", "text": "性之德也，合外内之道也。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-7ca86d22", "text": "唯天下至诚，为能尽其性。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-dd28f4ff", "text": "曲能有诚，诚则形，形则著，著则明，明则动，动则变，变则化。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-d55e73d9", "text": "君子之道，造端乎夫妇，及其至也，察乎天地。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-d10f2e0e", "text": "礼仪三百，威仪三千，待其人然后行。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-9df1ff38", "text": "上焉者虽善无征，无征不信，不信民弗从。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-843b2e93", "text": "下焉者虽善不尊，不尊不信，不信民弗从。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-27aa2107", "text": "是故君子动而世为天下道，行而世为天下法，言而世为天下则。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-7865a20b", "text": "非天子不议礼，不制度，不考文。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-e2c0eaea", "text": "虽有其德，苟无其位，亦不敢作礼乐焉。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"},
    {"id": "dq-8fd92bcc", "text": "虽有其位，苟无其德，不敢作礼乐焉。", "book": "礼记", "chapter": "中庸", "wrongSpeaker": "孔子"}
  ]
}
